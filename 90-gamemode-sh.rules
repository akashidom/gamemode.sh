polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units")
        return;

    if (!subject.isInGroup("gamemode"))
        return;

    const unit = action.lookup("unit");
    const verb = action.lookup("verb");

    const allowedUnits = [
        "tlp.service",
        "tlp-pd.service",
        "throttled.service"
    ];

    const allowedVerbs = [
        "start",
        "stop",
        "reset-failed"
    ];

    if (allowedUnits.indexOf(unit) !== -1 &&
        allowedVerbs.indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
});